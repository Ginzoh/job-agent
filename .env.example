# ---------------------------------------------------------------------------
# job-agent configuration. Copy this file to `.env` and fill in what you want.
# EVERY key here is OPTIONAL. With none of them set you still get 6 job sources.
# ---------------------------------------------------------------------------

# --- LLM backend -----------------------------------------------------------
# "claude"  -> uses the `claude` CLI you're already logged into (Pro plan). Default.
# "ollama"  -> uses a local model, zero cost, no rate limit. Needs Ollama running.
# "none"    -> skip AI scoring entirely, rule-based prefilter only.
LLM_BACKEND=claude

# Which Claude model the scorer uses. haiku is cheapest/fastest and is plenty
# good for triage; sonnet gives noticeably better reasoning on borderline jobs.
CLAUDE_MODEL=haiku

# Model used for CV tailoring and cover letters (the buttons in the dashboard).
# These run a few times a week rather than hundreds of times a run, so a
# stronger model is worth it here. Use "opus" for the best writing.
CLAUDE_MODEL_WRITE=sonnet

# Ollama settings (only used when LLM_BACKEND=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# How many jobs are packed into a single LLM call. Higher = cheaper & faster,
# but lower quality past ~10. 6-8 is the sweet spot.
SCORE_BATCH_SIZE=6

# Hard ceiling on how many jobs get sent to the LLM per run. Protects your
# Claude rate limit on the first run, when the DB is empty and everything is new.
SCORE_MAX_PER_RUN=120

# How many batches are scored in parallel. Each one is a separate `claude`
# process, so this is what actually determines throughput. 4 is comfortable;
# raise it if you're impatient, lower it to 1-2 if you hit rate limits.
SCORE_CONCURRENCY=4

# How long one scoring call may take before it's abandoned and retried on the
# next run. French postings are long and verbose, so they need more than the
# remote-board one-liners do.
LLM_TIMEOUT_MS=300000

# Hard ceiling on cumulative model spend, in USD, across ALL runs ever.
# Once lifetime spend crosses this, scoring refuses to start and tells you why.
# Set to 0 to disable the cap entirely.
#
# NOTE: this is a safety net based on the cost the CLI reports back — it is NOT
# an authoritative billing control. The only real guarantee lives in your
# Anthropic Console (disable auto-reload + set a spend limit). See the README.
MAX_SPEND_USD=90

# --- Adzuna (recommended: best France coverage, free tier) ------------------
# Free signup, 30 seconds, no card: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- France Travail / ex-Pôle Emploi (the official French job API) ----------
# Free signup: https://francetravail.io/ -> create an app -> subscribe to
# "Offres d'emploi v2" -> copy the client id/secret here.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Web dashboard ---------------------------------------------------------
WEB_PORT=7788
# Bind to 127.0.0.1 for local-only. Use 0.0.0.0 ONLY behind auth on a VPS.
WEB_HOST=127.0.0.1
# If set, the dashboard asks for this password (needed if exposed on a VPS).
WEB_PASSWORD=

# --- Watch mode ------------------------------------------------------------
# How often `yarn watch` re-runs the whole pipeline, in minutes.
WATCH_INTERVAL_MINUTES=360
