{
  "_comment": "MECHANICAL filters. These run before the LLM and are cheap. Their job is to throw out obvious junk so you don't burn tokens on it. Be generous here — let the LLM do the fine judgement.",

  "stack": {
    "_comment": "A job must mention at least `min_required_hits` terms from `required_any` to survive. Terms are matched case-insensitively on word boundaries.",
    "min_required_hits": 1,
    "required_any": [
      "react", "react.js", "reactjs",
      "node", "node.js", "nodejs",
      "typescript", "javascript",
      "next.js", "nextjs",
      "frontend", "front-end", "front end",
      "fullstack", "full-stack", "full stack",
      "développeur front", "developpeur front",
      "développeur fullstack", "developpeur fullstack"
    ],
    "nice_to_have": [
      "tailwind", "vite", "graphql", "postgres", "postgresql", "prisma",
      "express", "nestjs", "nest.js", "redux", "zustand", "vue", "svelte",
      "remix", "astro", "docker", "aws", "storybook", "playwright", "jest",
      "design system", "monorepo", "turborepo"
    ],
    "excluded": [
