      "switzerland", "suisse", "geneva", "geneve", "genève", "lausanne", "basel", "bale", "bâle", "zurich",
      "germany", "allemagne", "deutschland", "karlsruhe", "freiburg", "fribourg", "stuttgart", "offenburg", "kehl",

