      "uppsala", "linköping", "linkoping", "västerås", "vasteras", "örebro", "orebro",
      "helsingborg", "norrköping", "norrkoping", "jönköping", "jonkoping", "lund", "umeå", "umea",
      "solna", "sundbyberg", "kista", "gävle", "gavle", "borås", "boras",

      "remote", "teletravail", "télétravail", "distanciel", "hybrid", "hybride",
